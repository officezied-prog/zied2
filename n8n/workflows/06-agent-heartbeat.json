      "id": "eaa182cc-5abc-41f6-a957-fda236e9cb4a",
      "name": "Run analytics agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        540
      ],
      "retryOnFail": true,
      "maxTries": 1,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const run = $input.first().json || {};\nconst stats = $('GET /stats').first().json || {};\nconst week = new Date().toISOString().slice(0, 10);\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst output = esc(run.output || 'Agent returned no output (mode: ' + (run.mode || 'unknown') + ').');\nconst rows = Object.entries(stats).filter(([k, v]) => typeof v !== 'object').map(([k, v]) => '<tr><td style=\"padding:4px 12px 4px 0;color:#666\">' + esc(k) + '</td><td style=\"padding:4px 0\"><b>' + esc(v) + '</b></td></tr>').join('');\nconst pipeline = stats.pipeline ? Object.entries(stats.pipeline).map(([k, v]) => esc(k) + ': <b>' + esc(v) + '</b>').join(' · ') : '';\nconst html = '<div style=\"font-family:Inter,Arial,sans-serif;max-width:680px;color:#111\">'\n  + '<h2 style=\"margin:0 0 4px\">Rabith · Weekly business report</h2><div style=\"color:#666;margin-bottom:16px\">Week of ' + week + ' · run ' + esc(run.id || '') + ' · ' + esc(run.mode || '') + '</div>'\n  + '<table style=\"border-collapse:collapse;margin-bottom:12px\">' + rows + '</table>'\n  + (pipeline ? '<div style=\"margin-bottom:16px\">Pipeline — ' + pipeline + '</div>' : '')\n  + '<pre style=\"white-space:pre-wrap;font-family:inherit;line-height:1.5;background:#f6f6f6;padding:16px;border-radius:8px\">' + output + '</pre></div>';\nreturn [{ json: { subject: 'Rabith weekly report · ' + week, html, text: run.output || '' } }];"
      },
