    {
      "parameters": {
        "jsCode": "// Flatten the API payload { outreach, brand, contact } into one context object.\n// Everything downstream references $('Normalize').item.json.* so channel nodes can return anything.\nconst b = $input.first().json.body || {};\nconst o = b.outreach || {};\nconst brand = b.brand || {};\nconst contacts = Array.isArray(brand.contacts) ? brand.contacts : [];\nconst contact = b.contact || contacts.find(c => c.id === o.contactId) || contacts[0] || {};\nconst lang = ['en', 'ar', 'id'].includes(o.lang) ? o.lang : (['en', 'ar', 'id'].includes(contact.lang) ? contact.lang : 'en');\nconst channel = ['email', 'linkedin', 'whatsapp'].includes(o.channel) ? o.channel : 'email';\nconst step = Number(o.sequenceStep || 0);\nconst alreadySent = o.status === 'sent' && !!o.sentAt; // idempotency: never send twice\nconst contactName = contact.name || '';\nconst firstName = contactName.split(' ')[0] || (lang === 'id' ? 'Kak' : lang === 'ar' ? 'حضرتكم' : 'there');\nconst phone = String(contact.whatsapp || contact.phone || brand.whatsapp || '').replace(/[^0-9]/g, '');\nif (!o.id) throw new Error('outreach.id missing in payload');\nreturn [{ json: {\n  outreachId: o.id,\n  brandId: o.brandId || brand.id || null,\n  contactId: o.contactId || contact.id || null,\n  templateId: o.templateId || null,\n  lang, channel,\n  route: alreadySent ? 'skip' : channel,\n  step,\n  subject: o.subject || '',\n  body: o.body || '',\n  to: contact.email || null,\n  phone,\n  linkedin: contact.linkedin || null,\n  brandName: brand.name || '',\n  contactName, firstName,\n  alreadySent,\n  receivedAt: new Date().toISOString(),\n} }];"
      },
