    {
      "parameters": {
        "jsCode": "// Gmail trigger (simplified) → { senderEmail, text, channel }\nreturn $input.all().map(it => {\n  const j = it.json || {};\n  const fromRaw = j.From || j.from || ((j.headers || {}).from) || '';\n  const m = String(typeof fromRaw === 'object' ? (fromRaw.value || [{}])[0].address || '' : fromRaw).match(/[^<\\s\"']+@[^>\\s\"']+/);\n  return { json: { channel: 'email', senderEmail: m ? m[0].toLowerCase() : null, senderPhone: null, subject: j.Subject || j.subject || '', text: String(j.snippet || j.text || j.textPlain || '').slice(0, 2000), messageId: j.id || null, receivedAt: new Date().toISOString() } };\n}).filter(it => it.json.senderEmail);"
