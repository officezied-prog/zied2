    {
      "parameters": {
        "jsCode": "// Meta Cloud API inbound → { senderPhone, text }. Statuses (delivered/read) are ignored.\nconst out = [];\nfor (const it of $input.all()) {\n  const entries = ((it.json.body || {}).entry) || [];\n  for (const e of entries) for (const ch of (e.changes || [])) {\n    const v = ch.value || {};\n    for (const m of (v.messages || [])) {\n      const text = m.type === 'text' ? (m.text || {}).body : (m.type === 'button' ? (m.button || {}).text : (m.type === 'interactive' ? JSON.stringify(m.interactive) : '[' + m.type + ']'));\n      out.push({ json: { channel: 'whatsapp', senderEmail: null, senderPhone: String(m.from || '').replace(/[^0-9]/g, ''), subject: '', text: String(text || '').slice(0, 2000), messageId: m.id || null, receivedAt: new Date().toISOString() } });\n    }\n  }\n}\nreturn out;"
