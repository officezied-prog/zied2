    {
      "parameters": {
        "jsCode": "const p = ($input.first().json.body || {}).post || {};\nif (!p.id) throw new Error('post.id missing');\nconst hashtags = Array.isArray(p.hashtags) ? p.hashtags.map(h => h.startsWith('#') ? h : '#' + h) : [];\nconst caption = String(p.caption || '').trim();\nconst isVideo = /\\.(mp4|mov|m4v)(\\?|$)/i.test(String(p.mediaUrl || ''));\nconst platform = ['instagram', 'tiktok', 'linkedin', 'x'].includes(p.platform) ? p.platform : 'unsupported';\nconst text = platform === 'x' ? (caption + ' ' + hashtags.slice(0, 3).join(' ')).trim().slice(0, 280) : (caption + '\\n\\n' + hashtags.join(' ')).trim();\nreturn [{ json: { postId: p.id, platform, account: p.account || '@rabith.id', caption, hashtags, text, mediaUrl: p.mediaUrl || null, isVideo, lang: p.lang || 'id', scheduledAt: p.scheduledAt || null } }];"
      },
