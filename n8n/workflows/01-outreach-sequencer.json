    {
      "parameters": {
        "jsCode": "// Decide whether the sequence continues. Stops on: reply, bounce, pipeline moved, or a follow-up already existing (idempotency).\nconst c = $('Normalize').first().json;\nconst brand = $('Fetch brand').first().json || {};\nconst list = (($('Fetch outreach list').first().json || {}).items) || [];\nconst stopPipelines = ['replied', 'pilot', 'active', 'churned'];\nconst mine = list.find(x => x.id === c.outreachId) || {};\nconst repliedSameContact = list.find(x => x.contactId === c.contactId && x.status === 'replied');\nconst nextStep = c.step + 1;\nconst followupExists = list.find(x => x.contactId === c.contactId && Number(x.sequenceStep) === nextStep);\nlet reason = null;\nif (mine.status === 'replied' || repliedSameContact) reason = 'replied';\nelse if (mine.status === 'bounced') reason = 'bounced';\nelse if (stopPipelines.includes(brand.pipeline)) reason = 'pipeline:' + brand.pipeline;\nelse if (followupExists) reason = 'followup_exists:' + followupExists.id;\nelse if (nextStep > 2) reason = 'max_followups';\n// Templates that exist in the seed: followup1_{en,ar,id}, followup2_en. Fall back to English.\nconst available = { 1: ['en', 'ar', 'id'], 2: ['en'] };\nconst tl = (available[nextStep] || []).includes(c.lang) ? c.lang : 'en';\nreturn [{ json: { ...c, stop: !!reason, reason, nextStep, followupTemplateId: 'followup' + nextStep + '_' + tl, followupLang: tl, brandPipeline: brand.pipeline || null } }];"
      },
