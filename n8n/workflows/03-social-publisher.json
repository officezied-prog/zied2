    {
      "parameters": {
        "jsCode": "const p = $('Normalize post').first().json;\nconst r = $input.first().json || {};\nconst errText = e => typeof e === 'string' ? e : (e && (e.message || e.description)) || JSON.stringify(e);\nif (r.error) return [{ json: { ...p, status: 'failed', platformPostId: null, url: null, error: errText(r.error) } }];\nlet platformPostId = null, url = null;\nswitch (p.platform) {\n  case 'instagram':\n    platformPostId = r.id || null; url = r.permalink || null; break;\n  case 'tiktok':\n    platformPostId = (r.data || {}).publish_id || null; url = 'https://www.tiktok.com/' + p.account; break;\n  case 'linkedin':\n    platformPostId = r.id || null; url = platformPostId ? 'https://www.linkedin.com/feed/update/' + platformPostId : null; break;\n  case 'x':\n    platformPostId = (r.data || {}).id || null; url = platformPostId ? 'https://x.com/i/web/status/' + platformPostId : null; break;\n}\nconst ok = !!platformPostId;\nreturn [{ json: { ...p, status: ok ? 'published' : 'failed', platformPostId, url, error: ok ? null : 'no id returned by ' + p.platform, publishedAt: new Date().toISOString() } }];"
      },
