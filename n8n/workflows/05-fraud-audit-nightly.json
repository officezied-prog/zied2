    {
      "parameters": {
        "jsCode": "// Accepts either { items: Creator[] } (list) or a single Creator (by id). One item per creator.\nconst out = [];\nfor (const it of $input.all()) {\n  const j = it.json || {};\n  if (j.error) continue;\n  const list = Array.isArray(j.items) ? j.items : (j.id ? [j] : []);\n  for (const c of list) if (c && c.id) out.push({ json: c });\n}\nreturn out;"
      },
      "id": "27d5a66c-0954-4774-ae08-eb6355ff2a78",
      "name": "Flatten creators",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        180
      ]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "id": "b9813f90-df72-42ad-a050-848f336f2635",
      "name": "Loop creators",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1440,
        180
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FRAUD_SIGNALS_URL || 'https://api.modash.io/v1' }}/{{ $json.platform }}/profile/{{ String($json.handle || '').replace('@', '') }}/report",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "2134cc31-029b-4385-a0ce-089230f7ec58",
      "name": "External signals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        360
      ],
      "notes": "PLACEHOLDER external audit (Modash / HypeAuditor / your scraper). Credential: Header Auth \"Fraud signals API\". On error the Code node falls back to heuristic signals only.",
      "notesInFlow": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Merge external report (if any) with heuristic signals. Runs once per item.\nconst c = $('Loop creators').item.json;\nconst r = $json || {};\nconst ext = r.error ? {} : (r.profile || r.data || r);\nconst aud = ext.audience || {};\nconst num = v => (v === undefined || v === null || v === '' || Number.isNaN(Number(v))) ? null : Number(v);\nconst signals = {\n  source: r.error ? 'heuristic' : 'external+heuristic',\n  followerFollowingRatio: c.following ? +(c.followers / c.following).toFixed(2) : null,\n  engagementRate: num(c.engagementRate),\n  genericCommentRatio: num(c.genericCommentRatio),\n  growth30d: num(c.growth30d),\n  likesToViews: c.avgViews ? +(c.avgLikes / c.avgViews).toFixed(3) : null,\n  audienceCredibility: num(aud.credibility ?? ext.audience_credibility ?? ext.aqs),\n  suspiciousFollowersPct: num(ext.fake_followers_pct ?? aud.suspicious ?? (aud.credibility != null ? (1 - aud.credibility) * 100 : null)),\n  massFollowersPct: num(aud.massFollowers ?? aud.mass_followers),\n  audienceIndonesiaPct: num(((aud.geoCountries || []).find(g => /indonesia|ID/i.test(g.name || g.code || '')) || {}).weight),\n  auditedAt: new Date().toISOString(),\n  externalError: r.error ? String((r.error && (r.error.message || r.error.description)) || r.error) : null,\n};\nconst flags = [];\nif (signals.engagementRate !== null && signals.engagementRate < 1 && c.followers > 10000) flags.push('low_engagement_for_size');\nif (signals.followerFollowingRatio !== null && signals.followerFollowingRatio < 1.2 && c.followers > 5000) flags.push('follow_for_follow_pattern');\nif (signals.genericCommentRatio !== null && signals.genericCommentRatio > 0.5) flags.push('generic_comments');\nif (signals.growth30d !== null && signals.growth30d > 40) flags.push('growth_spike');\nif (signals.likesToViews !== null && signals.likesToViews > 0.5) flags.push('likes_exceed_plausible_views');\nif (signals.suspiciousFollowersPct !== null && signals.suspiciousFollowersPct > 25) flags.push('external_fake_followers');\nif (signals.audienceIndonesiaPct !== null && signals.audienceIndonesiaPct < 0.4) flags.push('audience_outside_indonesia');\nreturn { json: { creatorId: c.id, handle: c.handle, platform: c.platform, followers: c.followers, signals: { ...signals, flags } } };"
      },
      "id": "9dfee6c7-e9e7-4cb4-acc6-0c570862ba48",
