        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n    agent: 'analytics',\n    message: 'Weekly business report. Current stats: ' + JSON.stringify($json) + '. Cover: pipeline movement, outreach reply rate, campaigns live, creators added, fraud blocks, and the 3 actions for this week. Write in English with an Indonesian summary at the end.',\n    context: {}\n  }) }}"
