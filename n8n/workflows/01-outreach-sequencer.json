    {
      "parameters": {
        "jsCode": "// Join inbound replies with sent outreach via brand.contacts (email / whatsapp). Unknown senders are dropped.\nconst replies = [];\nfor (const name of ['Normalize email reply', 'Normalize WhatsApp reply']) { try { for (const it of $(name).all()) replies.push(it.json); } catch (e) { /* branch did not run */ } }\nconst sent = (($('List sent outreach').first().json || {}).items) || [];\nconst brands = (($('List brands').first().json || {}).items) || [];\nconst byEmail = new Map(), byPhone = new Map();\nfor (const b of brands) for (const c of (b.contacts || [])) {\n  if (c.email) byEmail.set(String(c.email).toLowerCase(), { brandId: b.id, contactId: c.id });\n  const ph = String(c.whatsapp || c.phone || '').replace(/[^0-9]/g, '');\n  if (ph) byPhone.set(ph, { brandId: b.id, contactId: c.id });\n}\nconst out = [];\nfor (const r of replies) {\n  const hit = r.senderEmail ? byEmail.get(r.senderEmail) : (r.senderPhone ? byPhone.get(r.senderPhone) : null);\n  if (!hit) continue;\n  const mine = sent.filter(o => o.contactId === hit.contactId).sort((a, b) => Number(b.sequenceStep || 0) - Number(a.sequenceStep || 0));\n  if (!mine.length) continue;\n  out.push({ json: { outreachId: mine[0].id, brandId: hit.brandId, contactId: hit.contactId, channel: r.channel, text: r.text, messageId: r.messageId, receivedAt: r.receivedAt } });\n}\nreturn out;"
      },
