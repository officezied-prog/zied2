    {
      "parameters": {
        "jsCode": "const items = (($input.first().json || {}).items) || [];\nlet audited = 0;\nfor (let run = 0; run < 100; run++) { let its; try { its = $('Compute signals').all(0, run); } catch (e) { break; } if (!its || !its.length) break; audited += its.length; }\nconst worst = items.slice(0, 15).map(c => ({ id: c.id, handle: c.handle, platform: c.platform, followers: c.followers, fraudScore: c.fraudScore, flags: c.fraudFlags || [] }));\nconst message = 'Nightly fraud audit finished. ' + audited + ' creators re-scored. Summarise anomalies, list creators that must be blocked from matching (fraudScore ≥ 60) and creators to re-check manually (40-59). Data: ' + JSON.stringify(worst);\nreturn [{ json: { audited, worst, message } }];"
      },
