    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst allowed = ['slack', 'whatsapp', 'email'];\nconst requested = String(b.channel || $env.FOUNDER_NOTIFY_CHANNEL || 'slack').toLowerCase();\nconst channel = allowed.includes(requested) ? requested : 'slack';\nconst text = String(b.text || b.message || '').trim() || '(empty notification)';\nconst title = String(b.title || text.split('\\n')[0]).slice(0, 120);\nreturn [{ json: { channel, text: text.slice(0, 4000), title, subject: 'Rabith · ' + title, sentAt: new Date().toISOString() } }];"
      },
      "id": "d6e46537-98c2-49ae-afaf-784158d5fea5",
      "name": "Normalize notification",
      "type": "n8n-nodes-base.code",
