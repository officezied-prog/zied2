      "name": "GET /health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json || {};\nconst ok = r.ok === true;\nconst store = $getWorkflowStaticData('global');\nconst now = Date.now();\nconst prev = store.lastState || 'unknown';\nconst state = ok ? (r.mode === 'claude' ? 'ok' : 'degraded') : 'down';\nconst changed = state !== prev;\nconst cooldownMs = 6 * 60 * 60 * 1000;\nconst alert = state !== 'ok' && (changed || !store.lastAlertAt || now - store.lastAlertAt > cooldownMs);\nconst recovered = state === 'ok' && prev === 'down';\nif (alert || recovered) store.lastAlertAt = now;\nstore.lastState = state;\nstore.lastCheckAt = now;\nconst detail = ok ? ('mode=' + r.mode + ' n8n=' + r.n8n + ' version=' + r.version) : ('error: ' + ((r.error && (r.error.message || r.error)) || 'no response'));\nconst text = recovered ? '✅ Rabith API recovered (' + detail + ')' : (state === 'down' ? '🔴 Rabith API DOWN · ' + detail : '🟠 Rabith API degraded (offline mode, Claude unavailable) · ' + detail);\nreturn [{ json: { ok, state, prev, alert: alert || recovered, text, detail, checkedAt: new Date(now).toISOString() } }];"
      },
      "id": "fec3f4d1-687c-450a-ab43-78b196d9a833",
