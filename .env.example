# ── Rabith platform ─────────────────────────────────────────────
PORT=8787
NODE_ENV=development

# Claude (the brain). Leave empty to run in offline/rule-based mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high

# n8n (the hands). Base URL of your n8n instance webhooks.
N8N_WEBHOOK_BASE=http://localhost:5678/webhook
# Shared secret: n8n sends it as header `x-rabith-secret` when calling the API,
# and the API sends it to n8n webhooks the same way.
RABITH_WEBHOOK_SECRET=change-me

# Optional channels used by n8n workflows (configure inside n8n credentials)
# GMAIL / WHATSAPP_BUSINESS / LINKEDIN / META_GRAPH / TIKTOK are n8n credentials, not here.

# ── Accounts ───────────────────────────────────────────────────
# Sign-in is optional by default (open demo). Set to 1 to require an account
# for every write; reads and n8n webhooks stay reachable.
RABITH_AUTH_REQUIRED=0
# First admin, created once on an empty database. CHANGE THE PASSWORD.
RABITH_ADMIN_EMAIL=admin@rabith.id
RABITH_ADMIN_PASSWORD=
# How long a session stays valid (days)
RABITH_SESSION_DAYS=30
